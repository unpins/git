compat/win32/pthread.h gates its pthread_sigmask stub by
__MINGW64_VERSION_MAJOR, but defines PTHREAD_H first, so the real winpthreads
<pthread.h> is never included and the call is an implicit declaration. Drop
the gate.

--- a/compat/win32/pthread.h
+++ b/compat/win32/pthread.h
@@ -91,12 +91,10 @@ static inline void *pthread_getspecific(pthread_key_t key)
 	return TlsGetValue(key);
 }
 
-#ifndef __MINGW64_VERSION_MAJOR
 static inline int pthread_sigmask(int how, const sigset_t *set, sigset_t *oset)
 {
 	return 0;
 }
-#endif
 
 #endif /* PTHREAD_H */
