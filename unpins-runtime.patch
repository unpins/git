--- a/Makefile
+++ b/Makefile
@@ -2689,6 +2689,22 @@
 
 OBJECTS += multicall.o
 
+# === unpins runtime: scripts/templates from the embedded ZIP, busybox linked in ===
+unpins_root := /__unpins_git__/
+unpins_miniz_defs := -DMINIZ_USE_ZSTD -DMINIZ_NO_TIME -DMINIZ_NO_ARCHIVE_WRITING_APIS \
+	-DMINIZ_NO_ZLIB_APIS -DMINIZ_NO_ZLIB_COMPATIBLE_NAMES
+ifeq ($(uname_S),MINGW)
+unpins_vfs_defs := -DUNPIN_VFS_WIN_MARKER='"__unpins_git__"'
+else
+unpins_vfs_defs := -DUNPIN_VFS_NOWRAP
+endif
+vfs.o:        EXTRA_CPPFLAGS = -DUNPIN_VFS_SELF -DUNPIN_VFS_ROOT='"$(unpins_root)"' $(unpins_vfs_defs) $(unpins_miniz_defs)
+miniz.o:      EXTRA_CPPFLAGS = -w $(unpins_miniz_defs)
+unpin_zstd.o: EXTRA_CPPFLAGS = -w $(unpins_miniz_defs) -DUNPIN_ZSTD_VENDORED
+# In libgit.a: common-main.o and run-command.o call into it from every program.
+LIB_OBJS += unpins_git.o vfs.o miniz.o unpin_zstd.o
+$(LIB_FILE): busybox.o
+
 $(unpins_mc_programs): git$X
 	$(QUIET_LNCP)$(RM) $@ && ln $< $@ 2>/dev/null || ln -s $< $@ 2>/dev/null || cp $< $@
 
