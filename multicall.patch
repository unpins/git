-git$X: git.o GIT-LDFLAGS $(BUILTIN_OBJS) $(GITLIBS)
+# === unpins multicall: fold helpers into git binary ===
+unpins_mc_objs := multicall.o daemon.o http-backend.o shell.o sh-i18n--envsubst.o scalar.o
+unpins_mc_programs := git-daemon$X git-http-backend$X git-shell$X git-sh-i18n--envsubst$X scalar$X
+daemon.o:           EXTRA_CPPFLAGS = -Dcmd_main=cmd_daemon_main
+http-backend.o:     EXTRA_CPPFLAGS = -Dcmd_main=cmd_http_backend_main
+shell.o:            EXTRA_CPPFLAGS = -Dcmd_main=cmd_shell_main
+sh-i18n--envsubst.o: EXTRA_CPPFLAGS = -Dcmd_main=cmd_sh_i18n_envsubst_main
+scalar.o:           EXTRA_CPPFLAGS = -Dcmd_main=cmd_scalar_main
+ifndef NO_CURL
+unpins_mc_objs     += remote-curl.o http.o http-walker.o http-fetch.o imap-send.o
+unpins_mc_programs += $(REMOTE_CURL_NAMES) git-http-fetch$X git-imap-send$X
+remote-curl.o: EXTRA_CPPFLAGS = -Dcmd_main=cmd_remote_curl_main
+http-fetch.o:  EXTRA_CPPFLAGS = -Dcmd_main=cmd_http_fetch_main
+imap-send.o:   EXTRA_CPPFLAGS = -Dcmd_main=cmd_imap_send_main
+EXTLIBS += $(CURL_LIBCURL) $(EXPAT_LIBEXPAT) $(IMAP_SEND_LDFLAGS)
+ifndef NO_EXPAT
+unpins_mc_objs     += http-push.o
+unpins_mc_programs += git-http-push$X
+http-push.o: EXTRA_CPPFLAGS = -Dcmd_main=cmd_http_push_main
+endif
+endif
+
+OBJECTS += multicall.o
+
+$(unpins_mc_programs): git$X
+	$(QUIET_LNCP)$(RM) $@ && ln $< $@ 2>/dev/null || ln -s $< $@ 2>/dev/null || cp $< $@
+
+git$X: git.o GIT-LDFLAGS $(BUILTIN_OBJS) $(GITLIBS) $(unpins_mc_objs)
 	$(QUIET_LINK)$(CC) $(ALL_CFLAGS) -o $@ $(ALL_LDFLAGS) \
