busybox becomes an object inside git. Its main is renamed to the
unpins_bb_main entry point (unpins_bb.c). unpins_bb.h routes busybox's
open/stat/access through the VFS, but win32/mingw.c defines the mingw_* calls
that redirect lands on, so it opts out. On darwin unpins_bb.h makes
bb_busybox_exec_path a call, and messages.c, which defines it, undoes that.

--- a/libbb/appletlib.c
+++ b/libbb/appletlib.c
@@ -1299,7 +1299,7 @@
 #if ENABLE_BUILD_LIBBUSYBOX
 int lbb_main(char **argv)
 #else
-int main(int argc UNUSED_PARAM, char **argv)
+int unpins_bb_main(int argc UNUSED_PARAM, char **argv)
 #endif
 {
 #if 0
